# Pinned inputs for the runner build.
#
# The runner is the Winlator base (LGPL-2.1) with our patches applied on top.
# Pinning the commit also pins the submodules (app/winlator-app, vortek,
# gladio), so the build is reproducible.

# Upstream base
WINLATOR_REPO=https://github.com/brunodev85/winlator.git
WINLATOR_REF=30aafbdb9eea47b92669201621e03cd2cf04540d

# Toolchain (the upstream app declares these)
ANDROID_COMPILE_SDK=35
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_NDK=24.0.8215888
CMAKE_VERSION=3.22.1
JAVA_VERSION=17

# Only arm64-v8a is published by upstream and it is what the phones run.
ANDROID_ABI=arm64-v8a

# Signing of the produced APK. The upstream app has no signingConfig for
# release, so the build script appends one (runner/patches/) and signs with
# apksigner.
KEYSTORE_PATH=${KEYSTORE_PATH:-runner/keystore/runner.keystore}
KEYSTORE_PASSWORD=${KEYSTORE_PASSWORD:-runner}
KEY_ALIAS=${KEY_ALIAS:-runner}
KEY_PASSWORD=${KEY_PASSWORD:-runner}
